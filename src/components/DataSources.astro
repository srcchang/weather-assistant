---
import { getTranslations, t } from '../i18n/translations';
import type { Locale } from '../i18n/config';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const tr = getTranslations(locale as Locale);

const items: { name: string; description: string }[] =
  (tr as Record<string, any>).sources?.items ?? [];
---

<section id="sources" class="border-t border-border-subtle bg-bg-surface px-4 py-16 sm:px-6 lg:px-8" data-reveal>
  <div class="mx-auto max-w-4xl">
    <div class="mb-10 text-center">
      <h2 class="text-2xl font-bold text-text-primary sm:text-3xl">
        {t(tr, 'sources.sectionTitle')}
      </h2>
      <p class="mt-3 text-text-secondary">
        {t(tr, 'sources.sectionSubtitle')}
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {items.map((item) => (
        <div class="rounded-xl border border-border-subtle bg-bg-primary p-5">
          <h3 class="font-semibold text-text-primary">{item.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
