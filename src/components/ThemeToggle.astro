---
import { getTranslations, t } from '../i18n/translations';
import type { Locale } from '../i18n/config';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const tr = getTranslations(locale as Locale);
const labelDark = t(tr, 'common.a11y.themeDark');
const labelLight = t(tr, 'common.a11y.themeLight');
---

<button
  data-theme-toggle
  data-label-dark={labelDark}
  data-label-light={labelLight}
  aria-label={labelDark}
  class="rounded-full p-2 transition-colors hover:bg-bg-muted"
>
  <svg
    class="icon-sun h-5 w-5 text-text-primary"
    style="display: none;"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41 1.41" />
  </svg>

  <svg
    class="icon-moon h-5 w-5 text-text-primary"
    style="display: block;"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  import '../scripts/theme-toggle';
</script>
