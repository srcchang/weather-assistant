---
import { getTranslations, t } from '../i18n/translations';
import type { Locale } from '../i18n/config';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const tr = getTranslations(locale as Locale);

const stats = [
  { target: t(tr, 'trust.languagesCount'), label: t(tr, 'trust.languages') },
  { target: t(tr, 'trust.areasCount'), label: t(tr, 'trust.areas') },
  { target: t(tr, 'trust.platformsLabel'), label: t(tr, 'trust.platforms') },
];
---

<section class="border-y border-border-subtle bg-bg-surface">
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-3 gap-y-8">
      {stats.map((stat) => (
        <div class="flex flex-col items-center text-center">
          <span
            class="bg-gradient-to-r from-primary-deep to-primary bg-clip-text text-3xl font-bold text-transparent sm:text-4xl"
          >
            {stat.target}
          </span>
          <span class="mt-1.5 text-sm text-text-secondary">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
